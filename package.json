{
  "name": "xz-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @xz/contracts run build && pnpm -r run typecheck",
    "test": "pnpm --filter @xz/contracts run build && pnpm -r run test",
    "build": "pnpm -r run build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@supabase/supabase-js": "^2.110.7",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "pg": "^8.22.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  }
}

# ---- API ----
NODE_ENV=development
API_PORT=3001

# Supabase 本地栈默认值（supabase start 输出为准）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# 仅供 /api/v1/admin/* 校验，不能使用 NEXT_PUBLIC_ 前缀，不能提交真实值。
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# ---- Worker ----
WORKER_POLL_INTERVAL_MS=2000

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_LOCAL_SPEECH_URL=http://127.0.0.1:6010

# ---- Local Speech ----
SPEECH_PORT=6010
# SPEECH_MODEL_ROOT=/absolute/path/to/local-models

# ---- MiniMax Realtime（仅供本机 speech 代理读取，严禁使用 NEXT_PUBLIC_ 前缀）----
MINIMAX_API_KEY=replace-with-minimax-api-key
MINIMAX_REALTIME_MODEL=abab6.5s-chat
MINIMAX_REALTIME_VOICE=female-shaonv
# MINIMAX_REALTIME_DEBUG=false
